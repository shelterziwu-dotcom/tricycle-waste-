# Copy to .env (start.bat does this automatically) and adjust if needed.

# --- WAMP / MySQL (default) ---
# WAMP's MySQL user is "root" with an empty password and port 3306.
# If you use WAMP's MariaDB instead, change 3306 to 3307.
# The tricycle_waste database is created automatically on first start.
DATABASE_URL=mysql+pymysql://root:@localhost:3306/tricycle_waste

# --- No MySQL? Use a local SQLite file instead ---
# DATABASE_URL=sqlite:///./tricycle_waste.db

# Use a long random string (at least 32 characters)
SECRET_KEY=change-this-to-a-long-random-secret-string

# First administrator account (created automatically; log in with phone 0000000000)
ADMIN_EMAIL=admin@tricyclewaste.local
ADMIN_PASSWORD=change-me-admin

MATCH_RADIUS_KM=3
OFFER_TIMEOUT_SECONDS=30
