# Copy to .env and fill in your values.
# Local development can use SQLite (no MySQL needed):
DATABASE_URL=sqlite:///./tricycle_waste.db
# Production / demo with MySQL (create the database first: CREATE DATABASE tricycle_waste;):
# DATABASE_URL=mysql+pymysql://root:your_password@localhost/tricycle_waste

# Use a long random string (at least 32 characters)
SECRET_KEY=change-this-to-a-long-random-secret-string

# First administrator account (created automatically on first start; log in with phone 0000000000)
ADMIN_EMAIL=admin@tricyclewaste.local
ADMIN_PASSWORD=change-me-admin

MATCH_RADIUS_KM=3
OFFER_TIMEOUT_SECONDS=30
